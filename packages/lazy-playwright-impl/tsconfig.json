{
  "extends": "@bluelovers/tsconfig/esm/mapfile.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "importHelpers": true,
    "noPropertyAccessFromIndexSignature": false,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "#/*": ["./*"]
    },
    "types": [
      "jest",
      "node"
    ]
  },
  "exclude": [
    "dist",
    "node_modules",
    "__fixtures__",
    "__snapshots__",
    "coverage",
    "test"
  ]
}
