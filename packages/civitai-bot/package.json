{
  "name": "civitai-bot",
  "version": "1.0.0",
  "description": "",
  "keywords": [
    "playwright",
    "create-by-yarn-tool"
  ],
  "license": "ISC",
  "author": "",
  "sideEffects": false,
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "coverage": "pnpm run test --coverage",
    "pretest": "echo pretest",
    "test": "node --run test:node",
    "test:jest": "jest --passWithNoTests",
    "test:jest:coverage": "node --run test:jest -- --coverage",
    "test:jest:snapshot": "node --run test:jest -- -u",
    "test:mocha": "ynpx --quiet -p ts-node -p mocha mocha -- --require ts-node/register \"!(node_modules)/**/*.{test,spec}.{ts,tsx}\"",
    "test:node": "node --run test:node:bin -- **/*.node-spec.ts **/*.node-test.ts **/*.spec.ts **/*.test.ts",
    "test:node:bin": "tsx --test --test-update-snapshots --",
    "test:node:bin:coverage": "node --run test:node:bin -- --experimental-test-coverage --",
    "test:node:coverage": "node --run test:node:bin:coverage -- **/*.node-spec.ts **/*.node-test.ts **/*.spec.ts **/*.test.ts",
    "test:snapshot": "pnpm run test -u",
    "test:tsc": "tsc --noEmit & echo Type checking completed (main)",
    "test:tsc:all": "node --run test:tsc && node --run test:tsc:sub",
    "test:tsc:sub": "cd test && tsc --noEmit & echo Type checking completed (test)",
    "test:tsd": "ynpx tsd",
    "test:tsdx": "ynpx @bluelovers/tsdx test --passWithNoTests",
    "build:dts:bundle": "ynpx @bluelovers/dts-bundle-generator -o ./dist/index.d.ts ./src/index.ts --no-banner --inline-declare-global & echo build:dts:bundle",
    "build:dts:copy": "copy .\\src\\index.d.ts .\\dist\\index.d.ts & echo build:dts",
    "build:dts:tsc": "node --run build:dts:tsc:emit & node --run build:dts:copy",
    "build:dts:tsc:emit": "tsc --emitDeclarationOnly --declaration --noEmit false",
    "build:microbundle": "ynpx microbundle --target node",
    "build:tsdx": "ynpx @bluelovers/tsdx build --target node --name index",
    "ci:install": "echo ci:install",
    "ci:build": "echo ci:build",
    "preversion": "echo preversion && pnpm run test",
    "version": "echo version",
    "prepublishOnly": "echo prepublishOnly",
    "publish": "echo publish",
    "postpublishOnly": "echo postpublishOnly",
    "bin:autopost": "tsx ./test/demo/auto-upload.ts --no-dry-run --publish --from-last-publish --ags-max-publish 1 --ags-max-publish-total",
    "sort-package-json": "yarn-tool sort",
    "tsc:default": "tsc -p tsconfig.json",
    "tsc:esm": "tsc -p tsconfig.esm.json",
    "tsc:showConfig": "ynpx get-current-tsconfig -p"
  },
  "dependencies": {
    "@bluelovers/string-natural-compare": "^2.0.17",
    "@lazy-playwright/logger": "^1.0.0",
    "@lazy-playwright/shared-types": "^1.0.0",
    "@ts-type/is-array": "^1.0.21",
    "cache-path": "^4.0.17",
    "debug-color2": "^1.3.2",
    "fast-glob": "^3.3.3",
    "lazy-playwright-impl": "^1.0.0",
    "playwright": "^1.65.0",
    "string-natural-compare2": "^3.0.1",
    "tslib": ">=2.9.1",
    "upath2": "^3.1.25",
    "yargs": "^18.2.0"
  }
}
